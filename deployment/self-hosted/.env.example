# Deployment variables for this Compose stack.
#
# Copy this file to `.env` **in this folder** (it is git-ignored) and edit the
# values. Compose loads the `.env` sitting next to the compose file, so a copy
# in the repository root is ignored here — that is what makes `docker compose
# config` report the defaults below instead of what you edited.
#
# Quick check after editing:
#
#   docker compose -f deployment/self-hosted/compose.yaml config | grep published
#

# Interface the HTTPS proxy publishes. Use the Tailscale or LAN address of this
# machine to reach Flowly from other devices; keep loopback for this machine
# only. Run `tailscale ip -4` to see yours.
FLOWLY_BIND_IP=127.0.0.1

# Port the proxy publishes. `443` gives URLs without a port; `8443` keeps a
# non-privileged mapping and every URL then carries `:8443`. Either way, the
# Enable Banking callback URL has to use exactly the same port.
FLOWLY_SITE_PORT=8443

# Hostname Caddy serves. It must match the host of the callback URL you register
# in the Enable Banking control panel.
FLOWLY_SITE_ADDRESS=flowly.local

# Storage engine for new vaults. Leave commented for the default.
# FLOWLY_STORAGE_ENGINE=sqlcipher

# Optional: an extra browser origin allowed to call the API.
# FLOWLY_ALLOWED_ORIGIN=
