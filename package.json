{
  "name": "flowly",
  "version": "0.0.0",
  "private": true,
  "description": "Flowly — self-hosted personal finance server with an encrypted vault on your own hardware.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @flowly/web-contracts build && pnpm -r --parallel dev",
    "test": "pnpm --filter @flowly/web-contracts build && pnpm -r test",
    "typecheck": "pnpm --filter @flowly/web-contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:generate": "pnpm --filter @flowly/web-contracts generate",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/web-contracts/src/generated",
    "check:frontend-secrets": "node tooling/scripts/check-frontend-secrets.mjs",
    "release:report": "node tooling/scripts/release-report.mjs",
    "release:check": "node tooling/scripts/release-report.mjs --check",
    "acceptance": "node tooling/scripts/acceptance.mjs",
    "ca:export": "node tooling/scripts/local-ca.mjs",
    "ca:trust": "node tooling/scripts/local-ca.mjs --apply",
    "verify": "pnpm format:check && pnpm lint && pnpm check:frontend-secrets && pnpm typecheck && pnpm test",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -f apps/server/Dockerfile ."
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "node-gyp": "^11.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
