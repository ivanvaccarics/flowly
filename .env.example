# Server bind address. Keep it on a private interface; never expose the service.
FLOWLY_HOST=127.0.0.1
FLOWLY_PORT=8787

# Directory holding the encrypted vault. One vault per deployment.
FLOWLY_VAULT_DIR=./data/vault

# Encrypted SQLite engine: sqlcipher (default) or record-encryption fallback.
FLOWLY_STORAGE_ENGINE=sqlcipher

# Optional extra browser origin allowed to call the API. The server always
# trusts its own origin; set this only for a separate front-end host (for
# example http://127.0.0.1:5173 when Vite runs its own server).
FLOWLY_ALLOWED_ORIGIN=

FLOWLY_LOG_LEVEL=info
NODE_ENV=development

# Session and vault lifetimes.
FLOWLY_SESSION_IDLE_MINUTES=15
FLOWLY_SESSION_ABSOLUTE_HOURS=12
FLOWLY_AUTO_LOCK_MINUTES=5
FLOWLY_UNLOCK_ATTEMPTS_PER_MINUTE=5
# Set to true only behind a trusted HTTPS reverse proxy.
FLOWLY_TRUST_PROXY=false

# Directory of the built web client served by the server on the same origin.
# The container sets this to /repo/apps/web/dist.
FLOWLY_WEB_DIR=apps/web/dist

# Never put secrets in VITE_* variables: they are embedded in the web bundle.
# The build fails if a VITE_* name looks like a secret.

# --- Docker Compose deployment only ---------------------------------------
# Interface and port the HTTPS proxy publishes. Keep the loopback default for a
# single-machine setup; use a private LAN or Tailscale address to reach Flowly
# from other devices (the Enable Banking callback URL has to match it).
# FLOWLY_BIND_IP=127.0.0.1
# FLOWLY_SITE_PORT=8443
# Hostname Caddy serves (and that browsers use); it must appear in the Enable
# Banking application's registered redirect URLs.
# FLOWLY_SITE_ADDRESS=flowly.local
