# Flowly configuration: copy this file to `.env` next to it.
#
# `docker compose up -d` reads it for the self-hosted stack. A server run
# outside Compose takes the same values from the environment:
#
#   set -a; source .env; set +a; pnpm dev
#
# Every value is optional; the ones shown are the defaults.

# --- Where Flowly answers (self-hosted stack) -----------------------------

# Interface the HTTPS proxy publishes. Docker Desktop runs that proxy in a VM
# which cannot bind the host's own LAN or Tailscale address, so it needs
# 0.0.0.0 there; on Linux, naming the address is the tighter choice.
FLOWLY_BIND_IP=127.0.0.1

# Port the proxy publishes. Use 443 for URLs without a port, 8443 otherwise:
# the Enable Banking callback URL has to carry the same port.
FLOWLY_SITE_PORT=8443

# Hostname Caddy serves, and the host of the Enable Banking callback URL.
FLOWLY_SITE_ADDRESS=flowly.local

# --- Server tuning (uncomment what you change) ----------------------------

# --- Container image -------------------------------------------------------

# Where the server image comes from. The default is the multi-architecture image
# GitHub Actions publishes on every change to the code (see
# docs/AUTOMATIC_STARTUP.md), so `docker compose pull` fetches it and nothing is
# compiled on this host. Pin a version tag for a reproducible install, or set
# flowly-server:local to use an image you built here on purpose.
# FLOWLY_IMAGE=ghcr.io/ivanvaccarics/flowly:latest

# FLOWLY_LOG_LEVEL=info
# FLOWLY_STORAGE_ENGINE=sqlcipher
# FLOWLY_SESSION_IDLE_MINUTES=15
# FLOWLY_SESSION_ABSOLUTE_HOURS=12
# FLOWLY_AUTO_LOCK_MINUTES=5
# FLOWLY_ALLOWED_ORIGIN=http://127.0.0.1:5173
