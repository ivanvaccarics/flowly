{
  "name": "@flowly/web-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Generated TypeScript types and runtime validators for the canonical Flowly contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
