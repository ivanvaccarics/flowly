{
  "name": "@flowly/server",
  "version": "0.0.0",
  "private": true,
  "description": "Flowly self-hosted server: API, domain, and encrypted vault.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run"
  },
  "dependencies": {
    "@flowly/web-contracts": "workspace:*",
    "@journeyapps/sqlcipher": "^6.0.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.4",
    "tar": "^7.5.22",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
